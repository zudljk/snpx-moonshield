---
import BaseLayout from "../../layouts/BaseLayout.astro";
import departures from "../../data/departures.json";
import { validateItinerary } from "../../utils/itinerary.mjs";

export function getStaticPaths() {
  const files = import.meta.glob("../../data/itinerary/*.json", { eager: true, import: "default" });
  const ids = [...new Set(departures.map((departure) => departure.itinerary).filter(Boolean))];
  return ids.map((id) => {
    const data = files[`../../data/itinerary/${id}.json`];
    if (!data) throw new Error(`Missing local itinerary ${id}.json. Import the Spansh result before building.`);
    return {
      params: { itinerary: id! },
      props: { jumps: validateItinerary(data, id) },
    };
  });
}

const { jumps } = Astro.props;
const distanceFormat = new Intl.NumberFormat("en", { maximumFractionDigits: 2 });
---

<BaseLayout title="Itinerary | [SNPX] Moonshield" description="Planned systems, jump distances and fuel usage for this journey.">
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Jump control</p>
        <h1>Itinerary</h1>
        {jumps.length > 0 && <p class="section-intro">{jumps[0].name} to {jumps[jumps.length - 1].name}</p>}
        <a class="back-link" href="/departures">Back to departures</a>
      </div>
      {jumps.length ? (
        <div class="panel itinerary-table" tabindex="0" role="region" aria-label="Itinerary stations">
          <table>
            <thead><tr>
              <th scope="col">System</th>
              <th scope="col">Distance (ly)</th>
              <th scope="col">Distance to destination (ly)</th>
              <th scope="col">Fuel used (t)</th>
            </tr></thead>
            <tbody>
              {jumps.map((jump) => <tr>
                <th scope="row"><span class="system-name">{jump.name}
                  <button type="button" class="copy-system" data-system={jump.name} aria-label={`Copy system name: ${jump.name}`} title="Copy system name">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <rect x="8" y="8" width="12" height="12" rx="2" />
                      <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
                    </svg>
                  </button>
                </span></th>
                <td>{distanceFormat.format(jump.distance)}</td>
                <td>{distanceFormat.format(jump.distance_to_destination)}</td>
                <td>{jump.fuel_used}</td>
              </tr>)}
            </tbody>
          </table>
        </div>
      ) : <p>No stations have been planned yet.</p>}
      <p id="copy-status" role="status" aria-live="polite"></p>
    </div>
  </section>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>("#copy-status");
  document.querySelectorAll<HTMLButtonElement>(".copy-system").forEach((button) => {
    button.addEventListener("click", async () => {
      const name = button.dataset.system!;
      try {
        await navigator.clipboard.writeText(name);
        if (status) status.textContent = `Copied ${name} to clipboard.`;
      } catch {
        if (status) status.textContent = `Could not copy ${name}. Please select and copy the system name manually.`;
      }
    });
  });
</script>

<style>
  .itinerary-table { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 1rem; border-bottom: 1px solid var(--line); text-align: right; }
  th:first-child { text-align: left; }
  thead th { color: var(--text-muted); font-weight: 500; }
  tbody th { font-weight: 400; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  td { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .system-name { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .copy-system { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-elevated); color: var(--amber); cursor: pointer; }
  .copy-system:hover { background: var(--amber-soft); }
  .copy-system:focus-visible, .itinerary-table:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  #copy-status { min-height: 1.5em; color: var(--text-muted); }
</style>
